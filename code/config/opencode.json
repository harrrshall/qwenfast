{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "model": "qwenfast/auto",
  "small_model": "qwenfast/qwen3.6-35b-a3b",
  "enabled_providers": ["qwenfast"],
  "provider": {
    "qwenfast": {
      "name": "Qwen Fast",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:7788/v1",
        "apiKey": "local",
        "timeout": false,
        "headerTimeout": 1800000,
        "chunkTimeout": 900000
      },
      "models": {
        "auto": {
          "name": "Auto (routes each task to the right model)",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 131072, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        },
        "qwen3.8-27b-xhigh": {
          "name": "Qwen3.8 27B, deep thinking",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 131072, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 131072, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        },
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B, fast",
          "reasoning": false,
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 131072, "output": 16384 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    }
  }
}
